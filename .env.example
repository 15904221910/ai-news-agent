# ===== LLM（必填）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ===== 新闻搜索（可选，留空自动降级 RSS）=====
# Tavily 免费额度（约 1000 次/月）注册：https://tavily.com
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# 自定义 RSS 源（逗号分隔，留空用内置默认源：量子位/IT之家/arXiv/MIT Tech Review/InfoQ/Solidot/开源中国/少数派）
# RSS_FEEDS=https://www.qbitai.com/feed,https://www.ithome.com/rss/
# HTTP 代理（可选，如 http://127.0.0.1:7890；用于提升 arXiv 等源可达性，Tavily 请求同样生效）
# HTTP_PROXY_URL=

# ===== 推送渠道（可选）=====
# Web 渠道无需配置；邮件需填 SMTP_*；企业微信/飞书/钉钉/通用 Webhook 在设置页填机器人地址即可
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== 运行配置（可选）=====
WORKSPACE_DIR=
DB_URL=
APP_TIMEZONE=Asia/Shanghai
MAX_STEPS=15
RUN_TIMEOUT_SECONDS=300
CONTEXT_BUDGET_TOKENS=60000
CONTEXT_SOFT_WARN_RATIO=0.70
CONTEXT_HARD_LIMIT_RATIO=0.85
LOG_LEVEL=INFO
